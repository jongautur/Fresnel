{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fresnel",
  "mainBinaryName": "fresnel",
  "version": "0.3.0",
  "identifier": "io.fresnel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fresnel",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Wi-Fi analysis and site survey tool",
    "longDescription": "Native Linux tool for Wi-Fi analysis and site surveys: adapter discovery, BSSID scanning and connection details. Works fully offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "network-manager"
        ],
        "section": "net",
        "desktopTemplate": "fresnel.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
